{
  "name": "kingdomhaus-deal-scanner",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "type": "module",
  "scripts": {
    "prepare:migration-rules": "tsx scripts/prepareMigrationRules.ts",
    "prepare:founder-rules": "tsx scripts/prepareFounderRules.ts",
    "dev:cloud": "vite --mode cloud --port 5176 --strictPort",
    "dev:cloud:emulator": "vite --mode cloud-emulator --port 5176 --strictPort",
    "emulators:start": "firebase emulators:start --only auth,firestore --project demo-kingdomhaus",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-kingdomhaus \"vitest run --config vitest.cloud.config.ts\"",
    "test:cloud:browser": "firebase emulators:exec --only auth,firestore --project demo-kingdomhaus \"tsx tests/cloud.browser.ts\"",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run test && npm run build",
    "build:production": "tsc --noEmit && tsx scripts/buildProduction.ts && npm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node build/server/index.js",
    "preview:production": "tsx scripts/previewProduction.ts",
    "test:production": "npm run build:production && vitest run --config vitest.production.config.ts"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
