# Server-only credentials: enter real values in the ignored .env file
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=8787
APIFY_API_TOKEN=
APIFY_MAX_CHARGE_USD=
APIFY_RUN_TIMEOUT_SECS=180

# Phase A: server-only authentication. Use the existing project and exact original founder UID.
# These values do not authorize new users. Never use VITE_* for Admin credentials.
FIREBASE_PROJECT_ID=
FIREBASE_FOUNDER_UID=
# Admin uses reviewed Application Default Credentials; no credential file is supplied here.
# Paid operations stay disabled until the following usage limits are explicitly approved and set.
# Process quotas count attempts, including failures/uncertain outcomes; restarting resets them.
OPENAI_MAX_REQUESTS_PER_PROCESS=
OPENAI_MAX_OUTPUT_TOKENS=
APIFY_MAX_RUNS_PER_PROCESS=

# Future cloud frontend configuration (public identifiers, never privileged keys).
# After separate Firebase setup approval, place these in ignored .env.cloud.local.
# API calls now require the existing configured Firebase session, including local development.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FOUNDER_UID=
